# CSV files are denied by default; only reviewed structural evidence is allowed.
*.csv
!evidence/hashes/*.csv
!config/**/*.csv
!tests/**/*.csv
!examples/public/**/*.csv

# Build artifacts
build/
dist/
*.egg-info/

